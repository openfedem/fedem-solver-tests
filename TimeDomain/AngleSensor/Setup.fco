#FEDEM calculation options
-fsifile "Model.fsi"
# Time integration parameters
-timeEnd 2.0
-timeInc 0.01
-alphaNewmark 0.1
# Newton-Raphson iteration parameters
-stressStiffDyn
-maxit 50
-nupdat 5
-maxSeqNoUpdate 5
-tolUpdateFactor 100
-tolDispNorm 1e-06
-tolVelNorm 1e-06
-tolEnerSum 1e-06
# Additional user-defined options
-allEngineVars
# Curve auto-export parameters
-curveFile "Beams.fmm"
-curvePlotType 5
-curvePlotPrec 1
# Switch off normal console output
-terminal -1
